# Copy this file to .env on the VM. Do not commit the real .env file.

NODE_ENV=production
PORT=5001
TZ=Asia/Kolkata

# Public URL that recipients can reach. Use your domain with HTTPS when available.
# For the current rootless Docker deployment, the default public port is 8080.
TRACKING_BASE_URL=
FRONTEND_URL=

# Rootless-router host port. Use a free high port unless you configure a privileged/forwarded 80/443 listener.
ROUTER_PORT=8091

# MongoDB
MONGODB_URI=

# Google OAuth / Gmail API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_USER_EMAIL=

# AutoBot draft sync (leave unset to keep the integration unavailable)
AUTOBOT_INTEGRATION_ID=jobs-sheet
AUTOBOT_OWNER_USER_ID=
AUTOBOT_DEFAULT_TEMPLATE_ID=
# SHA-256 hex digest of a dedicated random bearer token; never put the raw token here.
AUTOBOT_SYNC_TOKEN_SHA256=
# Optional. Must match the Mailium owner's configured sender identity.
AUTOBOT_SENDER_EMAIL=
# Optional; defaults to 500 and is capped at 500.
AUTOBOT_MAX_RECIPIENTS=500
